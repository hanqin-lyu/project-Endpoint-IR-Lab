// Scope check for IR-2026-FIN042: did the incident's accounts or files appear on any other device?
// This is the correlation the incident graph does for you, written out as a query.
//
// Tables and fields:
//   AlertEvidence       - AlertId, EntityType, AccountSid, SHA1, SHA256, DeviceName, Timestamp
//   DeviceLogonEvents   - AccountSid, DeviceName, ActionType, LogonType, Timestamp
//   DeviceProcessEvents - SHA1, SHA256, DeviceName, AccountName, Timestamp
//   DeviceFileEvents    - SHA1, SHA256, DeviceName, ActionType, Timestamp
//
// Incident alerts: every alert with evidence on vm-ir-lab-01 in the attack window
// (2026-11-24 04:30-07:00 UTC). Advanced hunting has no incident ID column, and incident 15
// holds every alert raised on this device in that window, so the device and window stand in
// for the incident's alert ID list.
//
// Accounts match on SID, not name: iradmin is a local account (RID 500), so another VM
// can have its own iradmin with a different SID. Hashes match SHA1 or SHA256, because
// custom rules 1 and 4 map SHA256 only.
//
// Search window: from the attack to now (advanced hunting keeps 30 days).
// RemoteIP is left out on purpose: it is the owner's public IP.
let attackStart = datetime(2026-11-24 04:30);
let attackEnd = datetime(2026-11-24 07:00);
let incidentDevice = "vm-ir-lab-01";
let incidentAlerts = AlertEvidence
    | where Timestamp between (attackStart .. attackEnd)
    | where DeviceName =~ incidentDevice
    | distinct AlertId;
let evidence = AlertEvidence
    | where Timestamp between (attackStart .. attackEnd)
    | where AlertId in (incidentAlerts);
let accounts = evidence
    | where EntityType == "User" and isnotempty(AccountSid)
    | distinct AccountSid;
let sha1s = evidence
    | where EntityType in ("File", "Process") and isnotempty(SHA1)
    | distinct SHA1;
let sha256s = evidence
    | where EntityType in ("File", "Process") and isnotempty(SHA256)
    | distinct SHA256;
union
    (
    DeviceLogonEvents
    | where Timestamp > attackStart
    | where ActionType == "LogonSuccess"
    | where AccountSid in (accounts)
    | project Timestamp, Source = strcat("Logon ", LogonType), DeviceName
    ),
    (
    DeviceProcessEvents
    | where Timestamp > attackStart
    | where SHA1 in (sha1s) or SHA256 in (sha256s)
    | project Timestamp, Source = "Process", DeviceName
    ),
    (
    DeviceFileEvents
    | where Timestamp > attackStart
    | where SHA1 in (sha1s) or SHA256 in (sha256s)
    | project Timestamp, Source = strcat("File ", ActionType), DeviceName
    )
// OtherDevice = true means activity outside the incident: scope is wider than one host
| extend OtherDevice = DeviceName !~ incidentDevice
| summarize Events = count(), FirstSeen = min(Timestamp), LastSeen = max(Timestamp)
    by DeviceName, OtherDevice, Source
| order by OtherDevice desc, FirstSeen asc
